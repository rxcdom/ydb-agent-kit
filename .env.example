# --- YDB (local container from docker-compose.yml) ---
YDB_ENDPOINT=grpc://ydb:2136
YDB_DATABASE=/local
YDB_CONNECT_ATTEMPTS=12
YDB_CONNECT_TIMEOUT_SECONDS=5
# Set to true only when connecting from the host through the published port.
YDB_DISABLE_DISCOVERY=false

# --- LLM provider (the only outbound network dependency) ---
YC_FOLDER_ID=
YC_API_KEY=
YC_IAM_TOKEN=
LLM_MODEL_NAME=gpt-oss-120b
LLM_TEMPERATURE=0.2

# --- Agent ---
AGENT_MAX_ITERATIONS=5
AGENT_HISTORY_LIMIT=20
AGENT_TIMEZONE=UTC

# --- Runtime ---
MIGRATION_APPLIED_BY=local
LOG_LEVEL=INFO
APP_PORT=8000
PYTHONUNBUFFERED=1

# --- Host ports published by docker compose (change one when it is already taken) ---
YDB_GRPC_HOST_PORT=2136
YDB_MON_HOST_PORT=8765
